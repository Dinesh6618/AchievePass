# Copy to .env.local and fill in. Only VITE_* values are exposed to the browser —
# they must be the *public* Supabase URL and anon/publishable key, never the service role key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The public address of this app. It goes into QR codes and into the password-reset link that faculty / admins can
# request, so it must be where your users really open the site:
#   local development:  http://localhost:5173
#   production:         https://certipass.your-college.edu
# If you leave it empty the browser's current address is used, which is correct for a normal deployment.
VITE_APP_URL=http://localhost:5173

# OCR provider: "tesseract" (in-browser, default), "http" (your own API) or "none" (manual entry only).
VITE_OCR_PROVIDER=tesseract
# Only for VITE_OCR_PROVIDER=http — see src/services/ocr/httpProvider.ts for the request/response contract.
VITE_OCR_API_URL=

# ---------------------------------------------------------------------------
# Server-side only (used by scripts/seed.mjs — NEVER prefix with VITE_).
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
